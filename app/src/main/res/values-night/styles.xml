<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:colorAccent">#2DD4BF</item>
        <item name="android:colorPrimary">#2DD4BF</item>
        <item name="android:statusBarColor">#0B1211</item>
        <item name="android:navigationBarColor">#0B1211</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="android:colorAccent">#2DD4BF</item>
    </style>
    <color name="bg">#0B1211</color>
</resources>
